--- !u!114 &3769417718296299469
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8246282329584477094}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1c73ac5275647994c92f6edb6baac611, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BalHanuman.SageNPC
  interactionRadius: 3.2
  sprite: {fileID: 1743089723411417611}
  marker: {fileID: 8331421329924884108}
  introLines:
  - speaker: Sage
    text: Little Hanuman, I need your help!
  - speaker: Hanuman
    text: Of course! What happened?
  - speaker: Sage
    text: The basket of mangoes for the temple offering has gone missing.
  - speaker: Hanuman
    text: Don't worry! I'll find it!
  - speaker: Sage
    text: Follow the forest path. May your journey be blessed!
  hintLines:
  - speaker: Sage
    text: Follow the forest path, little one. The mangoes will show you the way.
  finalLines:
  - speaker: Hanuman
    text: I found the basket!
  - speaker: Sage
    text: Wonderful, little Hanuman! Your kindness has brought joy to the forest.
  - speaker: Hanuman
    text: I'm happy I could help!
