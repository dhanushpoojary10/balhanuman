# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Windows / macOS noise
Thumbs.db
Desktop.ini
.DS_Store

# Old combat prototype and its first art set (not part of the current game)
/Assets/Legacy_Level1/
/Assets/Legacy_Level1.meta
/Assets/Art/
/Assets/Art.meta

# Local Android builds
Builds/
.utmp/
