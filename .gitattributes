# Normalise line endings for text files
* text=auto

# Unity YAML assets: treat as text, merge as unions-friendly text
*.unity text eol=lf linguist-language=Unity
*.prefab text eol=lf linguist-language=Unity
*.asset text eol=lf linguist-language=Unity
*.mat text eol=lf linguist-language=Unity
*.anim text eol=lf linguist-language=Unity
*.controller text eol=lf linguist-language=Unity
*.meta text eol=lf
*.physicsMaterial2D text eol=lf
*.inputactions text eol=lf
*.cs text eol=lf diff=csharp

# Large binary art and audio go through Git LFS
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
